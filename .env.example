# Copy to .env and adjust. docker compose and the backend both read it.

# Folder that holds your trail-camera media. Mounted READ-ONLY into the containers at /media.
TRAILCAM_MEDIA_HOST_DIR=C:/Users/pwall/Desktop/TrailCamera

# Host ports (change if something else already uses them).
TRAILCAM_DB_PORT=5432
TRAILCAM_API_PORT=8000
TRAILCAM_WEB_PORT=5173

# Native (non-Docker) development: point the backend at the compose database.
# TRAILCAM_DATABASE_URL=postgresql+psycopg://trailcam:trailcam@localhost:5432/trailcam
# TRAILCAM_TEST_DATABASE_URL=postgresql+psycopg://trailcam:trailcam@localhost:5432/trailcam_test
# TRAILCAM_LOG_FORMAT=console
# TRAILCAM_JOBS__BACKOFF_BASE_S=5
